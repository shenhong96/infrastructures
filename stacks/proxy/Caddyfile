{
    order filter after encode
    # auto_https off
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 168h
        }
    }
    email {env.ACME_EMAIL}
}

(themepark) {
    filter {
        content_type text/html.*
        search_pattern </head>
        replacement "<link rel='stylesheet' type='text/css' href='https://theme-park.dev/css/base/{args[0]}/{args[1]}.css'></head>"
    }
}

(themeparkLogo) {
    filter {
        content_type text/html.*
        search_pattern </head>
        replacement "<link rel='stylesheet' type='text/css' href='https://theme-park.dev/css/base/{args[0]}/{args[1]}.css'><link rel='stylesheet' type='text/css' href='https://theme-park.dev/css/addons/{args[0]}/{args[2]}/{args[2]}.css'></head>"
    }
}

(headers) {
    header {
        Permissions-Policy interest-cohort=()
        Strict-Transport-Security "max-age=31536000; includeSubdomains"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        X-Robots-Tag noindex, nofollow
        Referrer-Policy "same-origin"
    }
}

(remove_security_header) {
    header_down -x-webkit-csp
    header_down -content-security-policy
}

(remove_header_compression) {
    header_up -Accept-Encoding
}

*.ahlooii.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

