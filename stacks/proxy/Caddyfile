# More sites, kept encrypted in SOPS and written by the proxy role.
import /etc/caddy/private.caddy

pocket-id.ahlooii.com {
    reverse_proxy 192.168.9.151:1411 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

calibre.ahlooii.com {
    reverse_proxy 192.168.9.151:8083 {
        import remove_security_header
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            dial_timeout 300s
            response_header_timeout 300s
            read_timeout 300s
            write_timeout 300s
        }
    }
    import headers
}
