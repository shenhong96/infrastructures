audiobook.ahlooii.com {
    # Cache audio files (they rarely change)
    @audio_files path *.mp3 *.m4a *.m4b *.flac *.aac *.opus *.ogg
    header @audio_files Cache-Control "public, max-age=604800"
    
    # Enable range requests for streaming  
    header Accept-Ranges "bytes"

    # Streaming endpoints - no buffering
    @streaming {
        path /api/items/*/play*
        path /api/items/*/stream*
        path /api/items/*/download*
        path /api/items/*/file/*
    }
    
    reverse_proxy @streaming 192.168.9.151:13378 {
        transport http {
            read_timeout 600s
            write_timeout 600s
        }
        flush_interval -1    
    }

    reverse_proxy 192.168.9.151:13378 {
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
    import headers
}

