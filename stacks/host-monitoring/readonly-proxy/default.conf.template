# Door for Hermes (Oracle VM): GET on six Prometheus query paths, an off-by-default route to
# the homepage, the episode-coverage API (GET, plus POST on exactly four paths; its
# limits live in the API itself) and the diag app API (GET only). Everything else is 403.
# Written as JSON for Alloy.
log_format json escape=json '{"time":"$time_iso8601","remote":"$remote_addr","method":"$request_method","uri":"$log_uri","status":$status,"request_time":$request_time,"upstream_status":"$upstream_status"}';

# /diag/ requests (any method, even ones refused with 403) log only the app name, never the
# path or query string: they can carry secrets. Everything else logs $request_uri as before.
map $uri $diag_app {
    default "-";
    "~^/diag/(?<a>[a-z-]+)(/|$)" $a;
}
map $uri $log_uri {
    default   $request_uri;
    "~^/diag/" "/diag/$diag_app/[path withheld]";
}

# HOMEPAGE_ROUTE comes from compose: "on" opens /homepage/*, anything else keeps it shut.
map "${HOMEPAGE_ROUTE}" $homepage_open {
    default 0;
    "on"    1;
}

# GET anywhere a location allows it; POST only on these four paths.
map "$request_method:$uri" $method_ok {
    default                   0;
    "~^GET:"                  1;
    "POST:/coverage/watch"    1;
    "POST:/coverage/unwatch"  1;
    "POST:/coverage/refresh"  1;
    "POST:/coverage/grab"     1;
}

server {
    listen 9091;
    access_log /var/log/proxy/access.json json;
    access_log /dev/stdout json;

    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    if ($method_ok = 0) { return 403; }
    client_max_body_size 4k;

    location / { return 403; }

    location = /api/v1/query       { proxy_pass http://prometheus:9090; }
    location = /api/v1/query_range { proxy_pass http://prometheus:9090; }
    location = /api/v1/series      { proxy_pass http://prometheus:9090; }
    location = /api/v1/labels      { proxy_pass http://prometheus:9090; }
    location = /api/v1/metadata    { proxy_pass http://prometheus:9090; }
    location ~ ^/api/v1/label/[^/]+/values$ { proxy_pass http://prometheus:9090; }

    # The homepage container (stacks/aio, on the apps machine). It only answers its own allowed host.
    location /homepage/ {
        if ($homepage_open = 0) { return 403; }
        proxy_set_header Host 192.168.9.151:7777;
        proxy_pass http://192.168.9.151:7777/;
    }

    # Episode-coverage API (CT 118). It only answers requests from this host.
    location /coverage/ {
        proxy_read_timeout 120s;
        proxy_pass http://192.168.9.156:8795;
    }

    # diag app API (CT 121, on demand). The host's wake socket starts the CT; the first request
    # can wait out a cold start. GET only ($method_ok). Spec 2026-11-25 §6.3.
    location /diag/ {
        proxy_read_timeout 60s;
        proxy_pass http://unix:/run/diag-wake/diag.sock:;
    }
}
