# Copy to `secrets.env` and fill in. secrets.env is gitignored.
# Named secrets.env (not .env) so Docker Compose never parses these values for
# ${VAR} interpolation — avoids breakage if a password contains '$'.

# --- Nextcloud (CalDAV source) ---
# DAV root; the caldav lib auto-discovers the principal + calendars from here.
CALDAV_URL=https://nextcloud.ahlooii.com/remote.php/dav
# Your Nextcloud login name.
CALDAV_USERNAME=CHANGE_ME
# An APP PASSWORD (Settings -> Security -> Devices & sessions), NOT your password.
CALDAV_PASSWORD=CHANGE_ME
# Exact name of the Nextcloud calendar to mirror (case-insensitive).
CALDAV_CALENDAR_NAME=Personal

# --- Google (destination) ---
# A DEDICATED Google calendar (create it first). Keeps the mirror isolated from
# anything Hermes or you write elsewhere. Case-insensitive match by name.
GOOGLE_CALENDAR_NAME=Nextcloud
