#!/bin/bash
# Pre-deploy step of a Komodo stack (installed by roles/periphery). Run in the stack's folder:
#   komodo-decrypt-env secrets.sops.env [other.sops.env ...]
# decrypts each NAME.sops.env into NAME.env, readable by root only. Fails closed: if anything
# can't be decrypted, no NAME.env is left behind and the exit code stops the deploy.
# Never prints a value: a failure message names the file, nothing else. Komodo logs this
# command's output in the update, so keep it that way.
set -u
umask 077
export PATH=/usr/local/bin:/usr/bin:/bin
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-/etc/komodo/sops/age.key}"
unset SOPS_AGE_KEY SOPS_AGE_KEY_CMD SOPS_AGE_SSH_PRIVATE_KEY_FILE

fail() { echo "komodo-decrypt-env: $*" >&2; exit 1; }
[ "$#" -ge 1 ] || fail "no file named"
[ -r "$SOPS_AGE_KEY_FILE" ] || fail "the lab key is missing"

work=$(mktemp -d ./.decrypt.XXXXXX) || fail "cannot make a temporary folder here"
trap 'rm -rf "$work"' EXIT
trap 'exit 1' INT TERM HUP

targets=()
for src in "$@"; do
  case "$src" in
    */* | .* | *[!A-Za-z0-9._-]*) fail "bad file name" ;;
    *.sops.env) ;;
    *) fail "$src is not a .sops.env file" ;;
  esac
  targets+=("${src%.sops.env}.env")
done

drop_targets() { rm -f -- "${targets[@]}"; }
for src in "$@"; do
  dst="${src%.sops.env}.env"
  if ! sops --decrypt --input-type dotenv --output-type dotenv "$src" >"$work/$dst" 2>/dev/null || [ ! -s "$work/$dst" ]; then
    drop_targets # an older plaintext must not pass for the current one
    fail "cannot decrypt $src"
  fi
done
for dst in "${targets[@]}"; do
  mv -f -- "$work/$dst" "./$dst" || { drop_targets; fail "cannot place $dst"; }
done
echo "decrypted $# file(s)"
