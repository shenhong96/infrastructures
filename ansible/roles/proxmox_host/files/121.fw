[OPTIONS]

enable: 1
policy_in: DROP
policy_out: DROP
macfilter: 1
ipfilter: 1
# Static IPv4 only: no implicit DHCP, IPv6 neighbour discovery or router advertisements.
dhcp: 0
ndp: 0
radv: 0

[IPSET ipfilter-net0]

192.168.9.158

[RULES]

IN ACCEPT -source 192.168.9.152 -p tcp -dport 18796 -log nolog
OUT ACCEPT -dest 192.168.9.156 -p tcp -dport 18080,18090,18081,18989,17878,19696 -log nolog
OUT ACCEPT -dest 192.168.9.154 -p tcp -dport 18096 -log nolog
