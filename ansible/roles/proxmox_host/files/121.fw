[OPTIONS]

enable: 1
policy_in: DROP
policy_out: DROP
macfilter: 1
ipfilter: 1

[IPSET ipfilter-net0]

192.168.9.158

[RULES]

IN ACCEPT -source 192.168.9.152 -p tcp -dport 8796 -log nolog
OUT ACCEPT -dest 192.168.9.156 -p tcp -dport 8080,8090,8081,8989,7878,9696 -log nolog
OUT ACCEPT -dest 192.168.9.154 -p tcp -dport 8096 -log nolog
