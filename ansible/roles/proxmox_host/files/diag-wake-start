#!/bin/bash
# Start CT 121, then require an HTTP response THROUGH the pinned mTLS tunnel.
# A TCP port check would mistake a hostile endpoint or a failed TLS handshake for readiness.
set -u
running() { /usr/sbin/pct status 121 | grep -qx 'status: running'; }
# A failed start is fine if someone else started it meanwhile.
running || /usr/sbin/pct start 121 || running || exit 1
deadline=$((SECONDS + 30))
while (( SECONDS < deadline )); do
  curl --noproxy '*' --connect-timeout 1 --max-time 2 --fail --silent --output /dev/null \
    http://127.0.0.1:28796/diag/ && exit 0
  sleep 0.5
done
echo "diag did not answer through pinned mTLS within the startup budget" >&2
exit 1
