# Decrypted secrets: only the *.sops.* files are ever committed
secrets.env
.env
# Any decrypted env file next to a stack (komodo-decrypt-env writes NAME.env from NAME.sops.env)
*.env
!*.sops.env
*.dec
*.decrypted
*.decrypted.*

# Decrypted config blobs (komodo-decrypt-files) and config that is only committed as an encrypted *.sops.yaml blob
.decrypt*/
stacks/**/homepage/*.yaml
!stacks/**/homepage/*.sops.yaml
!stacks/**/homepage/kubernetes.yaml
stacks/**/homepage/*.bak*
stacks/**/smokeping/Targets
stacks/**/smokeping/ssmtp.conf
stacks/**/smokeping/ssmtp.conf.yaml

# Keys and credentials
*.agekey
keys.txt
id_rsa*
id_ed25519*
*.pem
*.key
.vault_pass*
vault_password*

# Legacy artifacts that must never come back
*.tfstate
*.tfstate.*
.terraform/

# Ansible
ansible/collections/
*.retry

# Editors and OS
.DS_Store
*.swp
*~

# Python
__pycache__/
*.pyc
